@page
@model HospitalRazor.Pages.Doctors.ProfileModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container py-5">
    @if (Model.Doctor == null)
    {
        <div class="alert alert-danger text-center shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i> Profile not found.
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                <!-- Left section: Profile picture & basic info -->
                <div class="col-md-4 bg-light d-flex flex-column align-items-center justify-content-center p-4">
                    <img src="@(Model.Doctor.Photo ?? "~/images/default-doctor.png")"
                         class="img-fluid rounded-circle shadow-sm mb-3"
                         style="width:160px;height:160px;object-fit:cover;" />
                    <h4 class="fw-bold mb-1">@Model.Doctor.FullName</h4>
                    <p class="text-primary mb-0"><i class="bi bi-person-badge me-1"></i>@Model.Doctor.Specialization</p>
                    <small class="text-muted">@Model.Doctor.Department?.Name</small>
                </div>

                <!-- Right section: Details -->
                <div class="col-md-8 p-4">
                    <h5 class="border-bottom pb-2 mb-3 fw-semibold text-uppercase text-secondary">Profile Details</h5>

                    <div class="row gy-3">
                        <div class="col-sm-6">
                            <i class="bi bi-envelope text-primary me-2"></i>
                            <strong>Email:</strong> @Model.Doctor.Email
                        </div>

                        <div class="col-sm-6">
                            <i class="bi bi-telephone text-primary me-2"></i>
                            <strong>Phone:</strong> @Model.Doctor.Phone
                        </div>

                        <div class="col-sm-6">
                            <i class="bi bi-mortarboard text-primary me-2"></i>
                            <strong>Qualification:</strong> @Model.Doctor.Qualification
                        </div>

                        <div class="col-sm-6">
                            <i class="bi bi-clock-history text-primary me-2"></i>
                            <strong>Experience:</strong> @Model.Doctor.ExperienceYears years
                        </div>

                        <div class="col-12">
                            <i class="bi bi-geo-alt text-primary me-2"></i>
                            <strong>Address:</strong> @Model.Doctor.Address
                        </div>

                        <div class="col-12">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            <strong>About:</strong>
                            <p class="mt-1 mb-0 text-muted">@Model.Doctor.About</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
