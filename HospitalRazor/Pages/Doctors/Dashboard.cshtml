@page
@model HospitalRazor.Pages.Doctors.DashboardModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_Layout";
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-semibold text-gray-800">Dashboard Overview</h2>
    <div class="flex items-center gap-3">
        <span class="me-3 fw-bold">@User.FindFirst("FullName")?.Value</span>
        <img src="~/images/doctor-avatar.png" class="w-10 h-10 rounded-full border" alt="avatar" />
    </div>
</div>

<!-- Stats cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white shadow-sm p-5 rounded-xl border-l-4 border-primary">
        <p class="text-gray-500 text-sm">Total Patients</p>
        <h3 class="text-3xl font-bold text-primary mt-2">@Model.TotalPatients</h3>
    </div>
    <div class="bg-white shadow-sm p-5 rounded-xl border-l-4 border-green-500">
        <p class="text-gray-500 text-sm">Appointments Today</p>
        <h3 class="text-3xl font-bold text-green-600 mt-2">@Model.TodayAppointments</h3>
    </div>
    <div class="bg-white shadow-sm p-5 rounded-xl border-l-4 border-yellow-500">
        <p class="text-gray-500 text-sm">Medical Records</p>
        <h3 class="text-3xl font-bold text-yellow-500 mt-2">@Model.TotalRecords</h3>
    </div>
    <div class="bg-white shadow-sm p-5 rounded-xl border-l-4 border-red-500">
        <p class="text-gray-500 text-sm">Pending Payments</p>
        <h3 class="text-3xl font-bold text-red-600 mt-2">@Model.PendingPayments</h3>
    </div>
</div>
