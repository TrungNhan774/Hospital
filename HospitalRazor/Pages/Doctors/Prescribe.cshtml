@page "{recordId:int}"
@model HospitalRazor.Pages.Doctors.PrescribeModel
@{
    ViewData["Title"] = "Prescribe Medicines";
    Layout = "_Layout";
}
<div class="bg-white shadow-md rounded-xl p-6">
    <h2 class="text-2xl font-bold text-gray-700 mb-6">Prescribe Medicines</h2>

    <!-- Thông tin bệnh nhân -->
    <div class="mb-6 border-b pb-4">
        <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center gap-2">
            <i class="bi bi-person-vcard text-blue-600"></i> Patient Information
        </h3>
        <dl class="divide-y divide-gray-200">
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Name</dt>
                <dd class="col-span-2 font-semibold">@Model.Patient?.PatientName</dd>
            </div>
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Gender</dt>
                <dd class="col-span-2">@Model.Patient?.Gender</dd>
            </div>
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Date of Birth</dt>
                <dd class="col-span-2">@Model.Patient?.DateOfBirth?.ToString("dd/MM/yyyy")</dd>
            </div>
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Phone</dt>
                <dd class="col-span-2">@Model.Patient?.Phone</dd>
            </div>
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Address</dt>
                <dd class="col-span-2">@Model.Patient?.Address</dd>
            </div>
            <div class="py-2 grid grid-cols-3 gap-4">
                <dt class="text-gray-500 font-medium">Medical History</dt>
                <dd class="col-span-2">@(string.IsNullOrWhiteSpace(Model.Patient?.MedicalHistory) ? "N/A" : Model.Patient.MedicalHistory)</dd>
            </div>
        </dl>
    </div>

    <!-- Thông tin hồ sơ -->
    @* <div class="mb-6 border-b pb-4">
        <h3 class="text-lg font-semibold text-gray-800 mb-2">Medical Record</h3>
        <p><strong>Diagnosis:</strong> @Model.MedicalRecord?.Diagnosis</p>
    </div> *@

    <!-- Form kê thuốc -->
    <form method="post" class="space-y-4">
        <div class="mb-6 border-b pb-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Medical Record</h3>

            <label class="text-sm font-medium text-gray-700">Diagnosis</label>
            <textarea asp-for="MedicalRecord.Diagnosis" rows="3"
                      class="form-textarea w-full rounded-md border-gray-300 mb-4"
                      placeholder="Enter diagnosis here..."></textarea>

            <!-- Prescription field -->
            <label class="text-sm font-medium text-gray-700">Prescription</label>
            <textarea asp-for="MedicalRecord.Prescription" rows="3"
                      class="form-textarea w-full rounded-md border-gray-300"
                      placeholder="Enter general prescription notes..."></textarea>
        </div>

        <h3 class="text-lg font-semibold text-gray-800 mb-3">Prescribed Medicines</h3>

        <div id="medicine-list">
            @for (int i = 0; i < Model.PrescriptionItems.Count; i++)
            {
                <div class="medicine-item grid grid-cols-1 md:grid-cols-4 gap-4 mb-3 bg-gray-50 p-3 rounded-lg">
                    <div>
                        <label class="text-sm font-medium">Medicine</label>
                        <select asp-for="@Model.PrescriptionItems[i].MedicineId" class="form-select w-full rounded-md border-gray-300">
                            <option value="">-- Select --</option>
                            @foreach (var med in Model.Medicines)
                            {
                                <option value="@med.MedicineId">@med.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-sm font-medium">Dosage</label>
                        <input asp-for="@Model.PrescriptionItems[i].Dosage" class="form-input w-full rounded-md border-gray-300" required />
                    </div>
                    <div>
                        <label class="text-sm font-medium">Quantity</label>
                        <input asp-for="@Model.PrescriptionItems[i].Quantity" 
                           type="number" 
                           min="0" 
                           class="form-input w-full rounded-md border-gray-300" 
                           required />
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addMedicineBtn" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">+ Add Medicine</button>

        <div class="mt-6">
            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">
                Save Prescription
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let medIndex = @Model.PrescriptionItems.Count;

    // Tạo sẵn danh sách option thuốc từ server
    const medicineOptions = `
        <option value="">-- Select --</option>
        @foreach (var med in Model.Medicines)
        {
            <text><option value="@med.MedicineId">@med.Name</option></text>
        }
    `;

    document.getElementById("addMedicineBtn").addEventListener("click", function () {
        const container = document.getElementById("medicine-list");
        const newRow = document.createElement("div");
        newRow.classList.add("medicine-item", "grid", "grid-cols-1", "md:grid-cols-4", "gap-4", "mb-3", "bg-gray-50", "p-3", "rounded-lg");
        newRow.innerHTML = `
            <div>
                <label class="text-sm font-medium">Medicine</label>
                <select name="PrescriptionItems[${medIndex}].MedicineId" class="form-select w-full rounded-md border-gray-300">
                    ${medicineOptions}
                </select>
            </div>
            <div>
                <label class="text-sm font-medium">Dosage</label>
                <input name="PrescriptionItems[${medIndex}].Dosage" class="form-input w-full rounded-md border-gray-300" required />
            </div>
            <div>
                <label class="text-sm font-medium">Quantity</label>
                <input name="PrescriptionItems[${medIndex}].Quantity" type="number" class="form-input w-full rounded-md border-gray-300" required />
            </div>`;
        container.appendChild(newRow);
        medIndex++;
    });
</script>
}
