@page "{id:int}"
@model HospitalRazor.Pages.Doctors.Records.DetailsModel
@{
    ViewData["Title"] = "Record Details";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
            <i class="bi bi-file-earmark-medical text-blue-600"></i>
            Medical Record Details
        </h2>
        <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-lg font-semibold">
            #@Model.Record?.RecordId
        </span>
    </div>

    <div class="bg-white shadow-md rounded-2xl p-6">
        @if (Model.Record == null)
        {
            <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg flex items-center gap-2">
                <i class="bi bi-exclamation-triangle"></i>
                Record not found.
            </div>
        }
        else
        {
            <dl class="divide-y divide-gray-200">
                <div class="py-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2 flex items-center gap-2">
                        <i class="bi bi-person-vcard text-blue-600"></i> Patient Information
                    </h3>

                    <div class="grid grid-cols-3 gap-4">
                        <dt class="text-gray-500 font-medium">Name</dt>
                        <dd class="col-span-2 text-gray-900 font-semibold">@Model.Record.Patient?.PatientName</dd>
                    </div>

                    <div class="grid grid-cols-3 gap-4 py-2">
                        <dt class="text-gray-500 font-medium">Gender</dt>
                        <dd class="col-span-2">@Model.Record.Patient?.Gender</dd>
                    </div>

                    <div class="grid grid-cols-3 gap-4 py-2">
                        <dt class="text-gray-500 font-medium">Date of Birth</dt>
                        <dd class="col-span-2">@Model.Record.Patient?.DateOfBirth?.ToString("dd/MM/yyyy")</dd>
                    </div>

                    <div class="grid grid-cols-3 gap-4 py-2">
                        <dt class="text-gray-500 font-medium">Phone</dt>
                        <dd class="col-span-2">@Model.Record.Patient?.Phone</dd>
                    </div>

                    <div class="grid grid-cols-3 gap-4 py-2">
                        <dt class="text-gray-500 font-medium">Address</dt>
                        <dd class="col-span-2">@Model.Record.Patient?.Address</dd>
                    </div>

                    <div class="grid grid-cols-3 gap-4 py-2">
                        <dt class="text-gray-500 font-medium">Medical History</dt>
                        <dd class="col-span-2">@(string.IsNullOrWhiteSpace(Model.Record.Patient?.MedicalHistory) ? "N/A" : Model.Record.Patient.MedicalHistory)</dd>
                    </div>
                </div>

                <div class="py-4 grid grid-cols-3 gap-4">
                    <dt class="text-gray-500 font-medium">Diagnosis</dt>
                    <dd class="col-span-2">@Model.Record.Diagnosis</dd>
                </div>

                <div class="py-4 grid grid-cols-3 gap-4">
                    <dt class="text-gray-500 font-medium">Prescription</dt>
                    <dd class="col-span-2">@Model.Record.Prescription</dd>
                </div>

                <div class="py-4 grid grid-cols-3 gap-4">
                    <dt class="text-gray-500 font-medium">Medicines</dt>
                    <dd class="col-span-2">
                        @if (Model.Record.MedicalRecordMedicines != null && Model.Record.MedicalRecordMedicines.Any())
                        {
                            <ul class="space-y-2">
                                @foreach (var m in Model.Record.MedicalRecordMedicines)
                                {
                                    <li class="flex items-center gap-2 bg-gray-50 p-3 rounded-lg border border-gray-200">
                                        <i class="bi bi-capsule text-blue-600"></i>
                                        <div>
                                            <span class="font-semibold">@m.Medicine?.Name</span>
                                            <span class="text-gray-600">— @m.Dosage</span>
                                            <span class="text-sm text-gray-500">(Qty: @m.Quantity)</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-gray-400 italic">No medicines recorded.</span>
                        }
                    </dd>
                </div>
            </dl>
        }
    </div>

    <div class="flex justify-end">
        <div class="flex justify-end gap-2">
            <a asp-page="./Index"
               class="flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg transition">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>

            @if (Model.Record != null &&
                 Model.Record.MedicalRecordMedicines != null &&
                 Model.Record.MedicalRecordMedicines.Count > 0)
            {
                @*  Khi đã kê thuốc *@
                <a asp-page="/Doctors/Records/Edit"
                   asp-route-id="@Model.Record.RecordId"
                   class="flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition">
                    <i class="bi bi-pencil-square"></i> Edit Record
                </a>
            }
            else
            {
                @*  Khi chưa kê thuốc *@
                <a asp-page="/Doctors/Prescribe"
                   asp-route-recordId="@Model.Record?.RecordId"
                   class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
                    <i class="bi bi-prescription"></i> Prescribe Medicine
                </a>
            }
        </div>
    </div>
