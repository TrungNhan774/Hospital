@page
@model HospitalRazor.Pages.Doctors.Records.IndexModel
@{
    ViewData["Title"] = "Patient Medical Records";
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold text-gray-800">Medical Records</h2>
        <a asp-page="/Doctors/Dashboard"
           class="flex items-center gap-2 text-sm bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700 transition">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form method="get" class="flex gap-2 items-center">
        <input type="text"
               name="SearchTerm"
               value="@Model.SearchTerm"
               placeholder="Search by patient name or phone..."
               class="border border-gray-300 rounded-lg px-4 py-2 w-80 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        <button type="submit"
                class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
            <i class="bi bi-search"></i> Search
        </button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-page="./Index"
               class="text-sm text-gray-500 hover:text-gray-700 ml-2">
                Clear
            </a>
        }
    </form>

    @if (Model.Records == null || !Model.Records.Any())
    {
        <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg flex items-center gap-2">
            <i class="bi bi-exclamation-triangle"></i>
            No medical records found for this doctor.
        </div>
    }
    else
    {
        <div class="overflow-x-auto bg-white shadow-md rounded-2xl">
            <table class="min-w-full text-sm text-left text-gray-600">
                <thead class="bg-gray-100 text-gray-700 text-sm font-semibold uppercase">
                    <tr>
                        <th class="px-6 py-3">Record ID</th>
                        <th class="px-6 py-3">Patient</th>
                         <th class="px-6 py-3">Phone</th>
                        <th class="px-6 py-3">Diagnosis</th>
                        <th class="px-6 py-3">Created At</th>
                        <th class="px-6 py-3 text-center w-28">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        <tr class="border-b hover:bg-gray-50 transition">
                            <td class="px-6 py-3 font-medium text-gray-900">@r.RecordId</td>
                            <td class="px-6 py-3">@((r.Patient?.PatientName) ?? "Unknown")</td>
                            <td class="px-6 py-3">@((r.Patient?.Phone) ?? "Unknown")</td>
                            <td class="px-6 py-3 text-gray-700">
                                @if (string.IsNullOrEmpty(r.Diagnosis))
                                {
                                    <span class="italic text-gray-400">No diagnosis</span>
                                }
                                else
                                {
                                    @r.Diagnosis
                                }
                            </td>
                            <td class="px-6 py-3">@r.CreatedAt?.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-3 text-center">
                                <a asp-page="./Details" asp-route-id="@r.RecordId"
                                   class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
