@page "{id:int}"
@model HospitalRazor.Pages.Doctors.Records.EditModel
@{
    ViewData["Title"] = "Edit Full Medical Record";
    Layout = "_Layout";
}

<div class="bg-white shadow-md rounded-xl p-6">
    <h2 class="text-2xl font-bold text-gray-700 mb-6">Edit Medical Record</h2>

    <form method="post" class="space-y-6">
        <input type="hidden" asp-for="MedicalRecord.RecordId" />
        <input type="hidden" asp-for="Patient.PatientId" />

        <!-- Patient Info -->
        <div class="border-b pb-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Patient Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Patient.PatientName" class="font-medium text-gray-700">Full Name</label>
                    <input asp-for="Patient.PatientName" class="form-input w-full border-gray-300 rounded-md" />
                </div>
                <div>
                    <label asp-for="Patient.Gender" class="font-medium text-gray-700">Gender</label>
                    <select asp-for="Patient.Gender" class="form-select w-full border-gray-300 rounded-md">
                        <option value="">-- Select --</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Patient.Phone" class="font-medium text-gray-700">Phone</label>
                    <input asp-for="Patient.Phone" class="form-input w-full border-gray-300 rounded-md" />
                </div>
                <div>
                    <label asp-for="Patient.DateOfBirth" class="font-medium text-gray-700">Date of Birth</label>
                    <input asp-for="Patient.DateOfBirth" type="date" class="form-input w-full border-gray-300 rounded-md" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Patient.Address" class="font-medium text-gray-700">Address</label>
                    <input asp-for="Patient.Address" class="form-input w-full border-gray-300 rounded-md" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Patient.MedicalHistory" class="font-medium text-gray-700">Medical History</label>
                    <textarea asp-for="Patient.MedicalHistory" rows="2" class="form-textarea w-full border-gray-300 rounded-md"></textarea>
                </div>
            </div>
        </div>

        <!-- Diagnosis & Prescription -->
        <div class="border-b pb-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Medical Record</h3>
            <label asp-for="MedicalRecord.Diagnosis" class="font-medium text-gray-700">Diagnosis</label>
            <textarea asp-for="MedicalRecord.Diagnosis" rows="3" class="form-textarea w-full rounded-md border-gray-300 mb-4"></textarea>

            <label asp-for="MedicalRecord.Prescription" class="font-medium text-gray-700">Prescription</label>
            <textarea asp-for="MedicalRecord.Prescription" rows="3" class="form-textarea w-full rounded-md border-gray-300"></textarea>
        </div>

        <!-- Medicines -->
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Prescribed Medicines</h3>
        <div id="medicine-list">
            @for (int i = 0; i < Model.PrescriptionItems.Count; i++)
            {
                <div class="medicine-item grid grid-cols-1 md:grid-cols-4 gap-4 mb-3 bg-gray-50 p-3 rounded-lg">
                    <div>
                        <label class="text-sm font-medium">Medicine</label>
                        <select asp-for="@Model.PrescriptionItems[i].MedicineId" class="form-select w-full rounded-md border-gray-300">
                            <option value="">-- Select --</option>
                            @foreach (var med in Model.Medicines)
                            {
                                <option value="@med.MedicineId">@med.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-sm font-medium">Dosage</label>
                        <input asp-for="@Model.PrescriptionItems[i].Dosage" class="form-input w-full rounded-md border-gray-300" required />
                    </div>
                    <div>
                        <label class="text-sm font-medium">Quantity</label>
                       <input asp-for="@Model.PrescriptionItems[i].Quantity" 
                           type="number" 
                           min="0" 
                           class="form-input w-full rounded-md border-gray-300" 
                           required />
                    </div>
                    <div class="flex items-end">
                        <button type="button" class="text-red-500 hover:underline" onclick="removeMedicineRow(this)">Remove</button>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addMedicineBtn" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">+ Add Medicine</button>

        <div class="mt-6">
            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let medIndex = @Model.PrescriptionItems.Count;

    const medicineOptions = `
        <option value="">-- Select --</option>
        @foreach (var med in Model.Medicines)
        {
            <text><option value="@med.MedicineId">@med.Name</option></text>
        }
    `;

    document.getElementById("addMedicineBtn").addEventListener("click", function () {
        const container = document.getElementById("medicine-list");
        const newRow = document.createElement("div");
        newRow.classList.add("medicine-item", "grid", "grid-cols-1", "md:grid-cols-4", "gap-4", "mb-3", "bg-gray-50", "p-3", "rounded-lg");
        newRow.innerHTML = `
            <div>
                <label class="text-sm font-medium">Medicine</label>
                <select name="PrescriptionItems[${medIndex}].MedicineId" class="form-select w-full rounded-md border-gray-300">
                    ${medicineOptions}
                </select>
            </div>
            <div>
                <label class="text-sm font-medium">Dosage</label>
                <input name="PrescriptionItems[${medIndex}].Dosage" class="form-input w-full rounded-md border-gray-300" required />
            </div>
            <div>
                <label class="text-sm font-medium">Quantity</label>
                <input name="PrescriptionItems[${medIndex}].Quantity" type="number" class="form-input w-full rounded-md border-gray-300" required />
            </div>
            <div class="flex items-end">
                <button type="button" class="text-red-500 hover:underline" onclick="removeMedicineRow(this)">Remove</button>
            </div>`;
        container.appendChild(newRow);
        medIndex++;
    });

    function removeMedicineRow(button) {
        button.closest(".medicine-item").remove();
    }
</script>
}
