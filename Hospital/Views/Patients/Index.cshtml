@model IEnumerable<DAL.Models.Patient>

<h2>Danh sách bệnh nhân</h2>

<table border="1" cellpadding="6">
    <tr>
        <th>ID</th>
        <th>Tên người dùng</th>
        <th>Giới tính</th>
        <th>Ngày sinh</th>
        <th>Địa chỉ</th>
        <th>Lịch sử bệnh</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PatientId</td>
            <td>@p.User?.FullName</td>
            <td>@p.Gender</td>
            <td>@(p.DateOfBirth.HasValue ? p.DateOfBirth.Value.ToString("dd/MM/yyyy") : "-")</td>
            <td>@p.Address</td>
            <td>@p.MedicalHistory</td>
        </tr>
    }
</table>
