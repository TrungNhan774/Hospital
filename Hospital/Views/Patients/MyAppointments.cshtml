@model IEnumerable<DAL.Models.Appointment>

@{
    ViewData["Title"] = "Lịch hẹn của tôi";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4"><i class="bi bi-calendar-check"></i> Lịch hẹn của tôi</h2>

    <!-- ✅ Hiển thị TempData thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> Bạn chưa có lịch hẹn nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white shadow-sm rounded-3">
                <thead class="table-primary">
                    <tr>
                        <th>Bác sĩ</th>
                        <th>Phòng</th>
                        <th>Ngày khám</th>
                        <th>Dịch vụ</th>
                        <th>Ghi chú</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Doctor?.FullName</td>
                            <td>@a.Room?.RoomNumber</td>
                            <td>@a.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (a.AppointmentServices != null && a.AppointmentServices.Any())
                                {
                                    foreach (var apService in a.AppointmentServices)
                                    {
                                        <span class="badge bg-secondary me-1">@apService.Service?.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Không có</span>
                                }
                            </td>

                            <td>@a.Notes</td>
                            <td>
                                @{
                                    string statusClass = a.Status switch
                                    {
                                        "Pending" => "badge bg-warning text-dark",
                                        "Confirmed" => "badge bg-success",
                                        "Cancelled" => "badge bg-danger",
                                        _ => "badge bg-secondary"
                                    };
                                }
                                <span class="@statusClass">@a.Status</span>
                            </td>
                            <td>
                                @if (a.Status == "Pending")
                                {
                                    <form asp-action="CancelAppointment" asp-controller="PatientAppointment" method="post" class="d-inline">
                                        <input type="hidden" name="appointmentId" value="@a.AppointmentId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-x-circle"></i> Hủy
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                        <i class="bi bi-lock"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
