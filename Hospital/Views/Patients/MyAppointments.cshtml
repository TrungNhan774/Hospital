@model IEnumerable<DAL.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">
        <i class="bi bi-calendar-check"></i> My Appointments
    </h2>

    <!-- ✅ Display TempData messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 🔹 Status filter -->
    <form method="get" asp-action="MyAppointments" class="row g-2 mb-4">
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- All statuses --</option>
                <option value="PENDING" selected="@(ViewBag.SelectedStatus == "PENDING")">Pending</option>
                <option value="CONFIRMED" selected="@(ViewBag.SelectedStatus == "CONFIRMED")">Confirmed</option>
                <option value="CANCELLED" selected="@(ViewBag.SelectedStatus == "CANCELLED")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="MyAppointments" class="btn btn-outline-secondary w-100">
                <i class="bi bi-arrow-clockwise"></i> Reset
            </a>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> You don’t have any appointments yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white shadow-sm rounded-3">
                <thead class="table-primary">
                    <tr>
                        <th>Doctor</th>
                        <th>Room</th>
                        <th>Date & Time</th>
                        <th>Services</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Doctor?.FullName</td>
                            <td>@a.Room?.RoomNumber</td>
                            <td>@a.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (a.AppointmentServices != null && a.AppointmentServices.Any())
                                {
                                    foreach (var apService in a.AppointmentServices)
                                    {
                                        <span class="badge bg-secondary me-1">@apService.Service?.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>

                            <td>@a.Notes</td>
                            <td>
                                @{
                                    string statusClass = a.Status switch
                                    {
                                        "PENDING" => "badge bg-warning text-dark",
                                        "CONFIRMED" => "badge bg-success",
                                        "CANCELLED" => "badge bg-danger",
                                        _ => "badge bg-secondary"
                                    };
                                }
                                <span class="@statusClass">@a.Status</span>
                            </td>
                            <td>
                                @if (a.Status == "PENDING")
                                {
                                    <form asp-action="CancelAppointment" asp-controller="PatientAppointment" method="post" class="d-inline">
                                        <input type="hidden" name="appointmentId" value="@a.AppointmentId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                        <i class="bi bi-lock"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
