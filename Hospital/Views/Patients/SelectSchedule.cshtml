@* Khai báo kiểu dữ liệu của Model mà View này nhận được *@
@model IEnumerable<DAL.Models.Schedule>

@{
    // Thiết lập tiêu đề trang
    ViewData["Title"] = "Select Schedule";
    // Lấy tên bác sĩ từ ViewBag đã được Controller truyền sang
    string doctorName = ViewBag.Doctorname;
}

<h1 class="text-primary">Đăng ký Lịch Khám</h1>

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    // Hiển thị thông báo nếu không có lịch trình
    <div class="alert alert-warning" role="alert">
        @ViewBag.Message
    </div>
}
else
{
    @* Phần này chỉ hiển thị nếu có lịch trình *@
    <h2 class="mb-4">Lịch Trình Khám của Bác Sĩ: @doctorName</h2>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Ngày Khám</th>
                <th>Ca Làm Việc</th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @* Lặp qua từng đối tượng Schedule trong Model *@
            @foreach (var schedule in Model)
            {
                <tr>
                    @* Dùng thuộc tính WorkDate *@
                    <td>@schedule.WorkDate.ToString("dd/MM/yyyy")</td>

                    @* Dùng thuộc tính Shift *@
                    <td>@schedule.Shift</td>

                    @* Dùng thuộc tính Available (phải kiểm tra null vì nó là bool?) *@
                    <td>
                        @if (schedule.Available.GetValueOrDefault()) // Dùng GetValueOrDefault() để xử lý bool?
                        {
                            <span class="badge bg-success">Còn Trống</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Đã Đầy</span>
                        }
                    </td>
                    <td>
                        @* Dùng thuộc tính Available để kiểm tra điều kiện đặt lịch *@
                        @if (schedule.Available.GetValueOrDefault())
                        {
                            <a asp-action="BookAppointment" asp-controller="PatientAppointment"
                               asp-route-scheduleId="@schedule.ScheduleId"
                               asp-route-doctorId="@ViewBag.DoctorId"
                               asp-route-departmentId="@ViewBag.DepartmentId"
                               class="btn btn-sm btn-primary">
                                Đặt Lịch
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>Hết Lịch</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-action="SelectDoctor" 
    asp-controller="PatientAppointment"
       asp-route-departmentId="@ViewBag.DepartmentId"
       class="btn btn-secondary">
        Quay lại Chọn Bác Sĩ
    </a>
</div>