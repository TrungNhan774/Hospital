<!-- Views/Account/ForgotPassword.cshtml -->
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h3>Forgot Password</h3>
                    <p>Enter your email to receive the OTP verification code</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">@ViewBag.Success</div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        <div class="mb-3">
                            <input type="email" name="email" class="form-control" placeholder="enter@email.com" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send OTP</button>
                    </form>

                    <p class="mt-3">
                        <a asp-action="Login" class="text-muted">Back to Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
