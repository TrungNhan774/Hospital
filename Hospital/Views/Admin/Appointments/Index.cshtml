@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<DAL.Models.Appointment>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Appointments</h2>
</div>

<form method="get" asp-action="Index" class="mb-3 d-flex">
    <input type="text" name="searchString" class="form-control me-2"
           placeholder="Search by doctor or patient..." value="@ViewBag.SearchString" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.SearchString))
    {
        <a href="/Appointments" class="btn btn-outline-secondary ms-2">Clear</a>
    }
</form>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Appointment Date</th>
            <th>Status</th>
            <th>Notes</th>
            <th>Doctor</th>
            <th>Patient</th>
            <th>Room</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1 + (Model.PageNumber - 1) * Model.PageSize;
            foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Status</td>
                    <td>@item.Notes</td>
                    <td>@item.Doctor?.FullName</td>
                    <td>@item.Patient?.PatientName</td>
                    <td>@item.Room?.RoomNumber</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.AppointmentId"
                           class="btn btn-info btn-sm text-white">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr><td colspan="8" class="text-center">No appointments found</td></tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(
        Model,
        page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 10,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>
