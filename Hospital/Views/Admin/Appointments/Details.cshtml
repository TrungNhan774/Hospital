@model DAL.Models.Appointment

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Appointment Details";
}

<h1 class="mb-3">Appointment Details</h1>

<div class="card shadow-sm p-4 mb-4 bg-white rounded">
    <h4 class="mb-3">Appointment Information</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AppointmentDate)</dt>
        <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9">
            @if (Model.Status?.ToLower() == "completed")
            {
                <span class="badge bg-success">Completed</span>
            }
            else if (Model.Status?.ToLower() == "pending")
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
            else if (Model.Status?.ToLower() == "cancelled")
            {
                <span class="badge bg-danger">Cancelled</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.Status</span>
            }
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                @Html.DisplayFor(model => model.Notes)
            }
            else
            {
                <span class="text-muted">No notes provided</span>
            }
        </dd>
    </dl>
</div>

<div class="card shadow-sm p-4 mb-4 bg-light rounded">
    <h4 class="mb-3">Doctor Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Model.Doctor?.FullName</dd>

        <dt class="col-sm-3">Specialization</dt>
        <dd class="col-sm-9">@Model.Doctor?.Specialization</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Doctor?.Phone</dd>
    </dl>
</div>

<div class="card shadow-sm p-4 mb-4 bg-light rounded">
    <h4 class="mb-3">Patient Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Patient Name</dt>
        <dd class="col-sm-9">@Model.Patient?.User</dd>

        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Patient?.Address</dd>
    </dl>
</div>

<div class="card shadow-sm p-4 mb-4 bg-light rounded">
    <h4 class="mb-3">Room Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Room Number</dt>
        <dd class="col-sm-9">@Model.Room?.RoomNumber</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@Model.Room?.Type</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left-circle"></i> Back to List
    </a>
</div>

