@model DAL.Models.Schedule

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Details";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Details</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <div>
                <h4>Schedule</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.WorkDate)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.WorkDate)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Shift)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Shift)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Available)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Available)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Doctor)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Doctor.DoctorId)
                    </dd>
                </dl>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model?.ScheduleId">Edit</a> |
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</div>