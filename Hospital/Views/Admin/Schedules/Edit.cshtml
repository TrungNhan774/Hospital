@model DAL.Models.Schedule

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Edit</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <h4>Schedule</h4>
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ScheduleId" />
                        <div class="form-group">
                            <label asp-for="DoctorId" class="control-label"></label>
                            <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId"></select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="WorkDate" class="form-label">Work Date</label>
                            <input asp-for="WorkDate" type="date" class="form-control" />
                            <span asp-validation-for="WorkDate" class="text-danger"></span>
                        </div>
                        <!-- Chọn ca làm -->
                        <div class="form-group mb-3">
                            <label asp-for="Shift" class="form-label">Shift</label>
                            <select asp-for="Shift" class="form-select">
                                <option value="">-- Select Shift --</option>
                                <option value="MORNING">MORNING</option>
                                <option value="AFTERNOON">AFTERNOON</option>
                                <option value="EVENING">EVENING</option>
                            </select>
                            <span asp-validation-for="Shift" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Available" class="control-label"></label>
                            <input asp-for="Available" class="form-control" />
                            <span asp-validation-for="Available" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Save" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
            <div>
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}