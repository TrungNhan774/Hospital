@model DAL.Models.DTO.DepartmentDTO

@{
    ViewBag.Title = "Department Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-building me-2"></i> @ViewBag.Title
        </h2>
        <a href="@Url.Action("Index", "AdminDepartment")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    @* Hiển thị cảnh báo nếu bị xóa mềm (Giống Patient Details không có nhưng giữ lại vì nó cung cấp UX tốt) *@
    @if (Model.IsDeleted)
    {
        <div class="alert alert-danger text-center mb-4 shadow-sm">
            <i class="bi bi-trash me-2"></i> This department has been **soft deleted** and is not fully active.
        </div>
    }

    <div class="card shadow-sm p-4 rounded-3">
        <dl class="row mb-0">

            @* === PHẦN 1: THÔNG TIN CƠ BẢN (Basic Info) === *@
            <h5 class="col-12 text-info pt-2 pb-1 mb-3 border-bottom"><i class="bi bi-info-circle me-1"></i> Basic Department Information</h5>

            <dt class="col-sm-3 fw-semibold">Department ID</dt>
            <dd class="col-sm-9">@Model.DepartmentId</dd>

            <dt class="col-sm-3 fw-semibold">Name</dt>
            <dd class="col-sm-9 fw-bold text-dark">@Model.Name</dd>

            <hr class="my-3" />

            @* === PHẦN 2: THÔNG TIN CHI TIẾT VÀ THỐNG KÊ (Details & Statistics) === *@
            <h5 class="col-12 text-info pt-2 pb-1 mb-3 border-bottom"><i class="bi bi-bar-chart-line me-1"></i> Operational Statistics</h5>

            <dt class="col-sm-3 fw-semibold">Total Doctors</dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary px-3 py-2">@Model.DoctorCount</span>
            </dd>

            <dt class="col-sm-3 fw-semibold">Total Rooms</dt>
            <dd class="col-sm-9">
                <span class="badge bg-success px-3 py-2">@Model.RoomCount</span>
            </dd>

            <hr class="my-3" />

            @* === PHẦN 3: MÔ TẢ & TRẠNG THÁI (Description & Status) === *@
            <h5 class="col-12 text-info pt-2 pb-1 mb-3 border-bottom"><i class="bi bi-card-text me-1"></i> Description and Status</h5>

            <dt class="col-sm-3 fw-semibold">Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.IsDeleted ? "danger" : "success") px-3 py-2">
                    @(Model.IsDeleted ? "Deleted" : "Active")
                </span>
            </dd>

            <dt class="col-sm-3 fw-semibold">Description</dt>
            <dd class="col-sm-9 text-wrap">
                @if (string.IsNullOrEmpty(Model.Description))
                {
                    <span class="text-muted fst-italic">No description provided.</span>
                }
                else
                {
                    @Model.Description
                }
            </dd>
        </dl>

        @* === KHỐI NÚT HÀNH ĐỘNG === *@
        <div class="d-flex justify-content-end mt-4 gap-2 border-top pt-3">
            @if (!Model.IsDeleted)
            {
                <a href="@Url.Action("Edit", "AdminDepartment", new { id = Model.DepartmentId })"
                   class="btn btn-warning text-white">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
            }

            @if (Model.IsDeleted)
            {
                <form asp-controller="AdminDepartment"
                      asp-action="Restore"
                      asp-route-id="@Model.DepartmentId"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to restore this department?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                    </button>
                </form>
            }
            <a href="@Url.Action("Index", "AdminDepartment")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<style>
    /* Đảm bảo Description có thể xuống dòng */
    .text-wrap {
        white-space: normal;
    }
</style>