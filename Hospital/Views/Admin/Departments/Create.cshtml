@model DAL.Models.DTO.DepartmentDTO

@{
    ViewBag.Title = "Add New Department";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-building-add me-2"></i> @ViewBag.Title
        </h2>
        <a href="@Url.Action("Index", "AdminDepartment")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    @* Thêm Alert thông báo (giả định có TempData từ Controller) *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        @* Hiển thị ValidationSummary ở đầu form, chỉ hiện lỗi model-level *@
        @Html.ValidationSummary(true, "", new { @class = "text-danger alert alert-danger mb-3 p-2" })

        <div class="card shadow-sm p-4 rounded-3">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="card-title text-info mb-3"><i class="bi bi-tag me-1"></i> Department Identity</h5>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Department Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter department name (e.g., Cardiology, Surgery)" required />
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="card-title text-info mb-3"><i class="bi bi-card-text me-1"></i> Additional Details</h5>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Briefly describe the department's function"></textarea>
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div> @* End of row *@

            @* Thay đổi nút bấm cho giống phong cách Patient: Create Patient -> Create Department *@
            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i> Create Department
                </button>
                <a href="@Url.Action("Index", "AdminDepartment")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}