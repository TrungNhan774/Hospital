@model IEnumerable<DAL.Models.DTO.DepartmentDTO>

@{
    ViewBag.Title = "Departments Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">

    <!-- 🔹 Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-building-fill me-2"></i> @ViewBag.Title
        </h2>
        <a asp-controller="AdminDepartment" asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Add New Department
        </a>
    </div>

    <!-- 🔹 Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 🔹 Table -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="bi bi-info-circle me-2"></i>No departments found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary">
                            <tr class="text-center">
                                <th>Name</th>
                                <th>Description</th>
                                <th>Doctors</th>
                                <th>Rooms</th>
                                <th style="width: 240px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                <tr class="text-center">
                                    <td class="fw-semibold text-start ps-4">@d.Name</td>
                                    <td class="text-start text-truncate" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(d.Description)
                                                                        ? "<em class='text-muted'>No description</em>"
                                                                        : d.Description)
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-75 px-3 py-2">
                                    @d.DoctorCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-75 px-3 py-2">
                                    @d.RoomCount
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <!-- Details -->
                                    <a asp-controller="AdminDepartment"
                                       asp-action="Details"
                                       asp-route-id="@d.DepartmentId"
                                       class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>

                                            <!-- Edit -->
                                            <a asp-controller="AdminDepartment"
                                               asp-action="Edit"
                                               asp-route-id="@d.DepartmentId"
                                               class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>

                                            <!-- Delete -->
                                            <form asp-controller="AdminDepartment"
                                                  asp-action="DeleteConfirmed"
                                                  asp-route-id="@d.DepartmentId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this department?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    table th {
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .btn-outline-info:hover {
        background-color: #0dcaf0;
        color: white;
    }

    .btn-outline-warning:hover {
        background-color: #ffc107;
        color: white;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease-in-out;
    }
</style>
