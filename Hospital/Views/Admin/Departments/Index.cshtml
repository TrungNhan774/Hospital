@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<DAL.Models.DTO.DepartmentDTO>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Departments Management";

    var currentSearch = ViewBag.Search as string;
    var currentPage = Model?.PageNumber ?? 1;
}

<div class="container-fluid px-4 py-3">

    <!-- Header + Add -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-building-fill me-2"></i> @ViewBag.Title
        </h2>

        <a asp-controller="AdminDepartment" asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Department
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Search + Clear -->
    <form method="get" asp-action="Index" class="mb-3 d-flex gap-2">
        <input type="text" name="search" class="form-control" placeholder="Search by name..." value="@currentSearch" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(currentSearch))
        {
            <a asp-controller="AdminDepartment" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </form>

    <!-- Table -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            <i class="bi bi-info-circle me-2"></i>No departments found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark text-secondary">
                            <tr class="text-center">
                                <th>Name</th>
                                <th>Description</th>
                                <th>Doctors</th>
                                <th>Rooms</th>
                                <th style="width: 280px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                <tr class="text-center @(d.IsDeleted ? "table-danger opacity-75" : "")">
                                    <td class="fw-semibold text-start ps-4">
                                        @d.Name
                                        @if (d.IsDeleted)
                                        {
                                            <span class="badge bg-danger ms-2">Deleted</span>
                                        }
                                </td>
                                <td class="text-start text-truncate" style="max-width: 250px;">
                                    @(string.IsNullOrEmpty(d.Description)
                                                                    ? Html.Raw("<em class='text-muted'>No description</em>")
                                                                    : Html.Raw(d.Description))

                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-75 px-3 py-2">@d.DoctorCount</span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-75 px-3 py-2">@d.RoomCount</span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <a asp-controller="AdminDepartment"
                                       asp-action="Details"
                                       asp-route-id="@d.DepartmentId"
                                       class="btn btn-info shadow-sm px-3 rounded">
                                        <i class="bi bi-eye me-1"></i> Details
                                    </a>

                                    @if (!d.IsDeleted)
                                            {
                                                <a asp-controller="AdminDepartment"
                                                   asp-action="Edit"
                                                   asp-route-id="@d.DepartmentId"
                                                   class="btn btn-warning shadow-sm px-3 rounded">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>

                                                <button type="button"
                                                        class="btn btn-danger shadow-sm px-3 rounded btn-delete"
                                                        data-id="@d.DepartmentId"
                                                        data-name="@d.Name">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success shadow-sm px-3 rounded btn-restore"
                                                        data-id="@d.DepartmentId"
                                                        data-name="@d.Name">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="mt-3 d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = currentSearch }),
            new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 10,
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
    </div>
        }
</div>

<!-- Modal Delete/Restore -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white" id="actionModalHeader">
                <h5 class="modal-title" id="actionModalTitle">Confirm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="actionModalText"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" id="actionForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" id="actionConfirmBtn"></button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modal = new bootstrap.Modal(document.getElementById('actionModal'));
        const actionForm = document.getElementById('actionForm');
        const actionTitle = document.getElementById('actionModalTitle');
        const actionBody = document.getElementById('actionModalText');
        const actionBtn = document.getElementById('actionConfirmBtn');
        const actionHeader = document.getElementById('actionModalHeader');

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name;
                actionForm.action = `/AdminDepartment/Delete/${id}`;
                actionTitle.textContent = "Confirm Delete";
                actionBody.textContent = `Are you sure you want to delete department "${name}"?`;
                actionBtn.className = "btn btn-danger";
                actionBtn.textContent = "Delete";
                actionHeader.className = "modal-header bg-danger text-white";
                modal.show();
            });
        });

        document.querySelectorAll('.btn-restore').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name;
                actionForm.action = `/AdminDepartment/Restore/${id}`;
                actionTitle.textContent = "Confirm Restore";
                actionBody.textContent = `Are you sure you want to restore department "${name}"?`;
                actionBtn.className = "btn btn-success";
                actionBtn.textContent = "Restore";
                actionHeader.className = "modal-header bg-success text-white";
                modal.show();
            });
        });
    </script>
}

<style>
    table th {
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s;
    }

    .btn-outline-info:hover,
    .btn-outline-warning:hover,
    .btn-outline-danger:hover,
    .btn-outline-success:hover {
        color: white;
    }
</style>
