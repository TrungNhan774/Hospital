@model DAL.Models.DTO.PatientDTO
@{
    ViewBag.Title = "Patient Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-info-circle me-2"></i> @ViewBag.Title
        </h2>
        <a href="@Url.Action("Index", "AdminPatient")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm p-4 rounded-3">
        <dl class="row mb-0">
            <dt class="col-sm-3 fw-semibold">Patient ID</dt>
            <dd class="col-sm-9">@Model.PatientId</dd>

            <dt class="col-sm-3 fw-semibold">Patient Name</dt>
            <dd class="col-sm-9 fw-bold text-dark">@Model.PatientName</dd>

            <dt class="col-sm-3 fw-semibold">Phone</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrEmpty(Model.Phone))
                {
                    <span class="text-muted">N/A</span>
                }
                else
                {
                    @Model.Phone
                }
            </dd>

            <dt class="col-sm-3 fw-semibold">User Account</dt>
            <dd class="col-sm-9">@Model.UserFullName</dd>

            <hr class="my-3" />

            <dt class="col-sm-3 fw-semibold">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3 fw-semibold">Gender</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.Gender == "Male" ? "primary" : "pink") bg-opacity-75 px-3 py-2">
                    @Model.Gender
                </span>
            </dd>

            <dt class="col-sm-3 fw-semibold">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3 fw-semibold">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsDeleted)
                {
                    <span class="badge bg-danger px-3 py-2">Deleted</span>
                }
                else
                {
                    <span class="badge bg-success px-3 py-2">Active</span>
                }
            </dd>

            <hr class="my-3" />

            <dt class="col-sm-3 fw-semibold">Medical History</dt>
            <dd class="col-sm-9 text-wrap">
                @if (string.IsNullOrEmpty(Model.MedicalHistory))
                {
                    <span class="text-muted fst-italic">No medical history recorded.</span>
                }
                else
                {
                    @Model.MedicalHistory
                }
            </dd>
        </dl>

        <div class="d-flex justify-content-end mt-4 gap-2">
            @if (!Model.IsDeleted)
            {
                <a href="@Url.Action("Edit", "AdminPatient", new { id = Model.PatientId })" class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
            }
            <a href="@Url.Action("Index", "AdminPatient")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<style>
    .text-wrap {
        white-space: normal;
    }

    .badge.bg-pink {
        background-color: #e83e8c !important;
        color: white;
    }
</style>