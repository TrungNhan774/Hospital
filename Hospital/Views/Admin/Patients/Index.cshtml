@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<DAL.Models.DTO.PatientDTO>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Patients Management";
}

<!-- Thông báo -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <a asp-controller="AdminPatient" asp-action="Create" class="btn btn-primary">Add Patient</a>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<form method="get" asp-action="Index" class="mb-3 d-flex gap-2">
    <input type="text" name="search" class="form-control" placeholder="Search by name or address..." value="@ViewBag.Search" />
    <select name="gender" class="form-select" asp-items="ViewBag.Genders">
        <option value="">All Genders</option>
    </select>
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.Gender))
    {
        <a asp-controller="AdminPatient" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    }
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Patient Name</th>
            <th>DOB</th>
            <th>Gender</th>
            <th>Address</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1 + (Model.PageNumber - 1) * Model.PageSize;
            foreach (var p in Model)
            {
                <tr id="row-@p.PatientId" class="@(p.IsDeleted ? "table-danger" : "")">
                    <td>@i</td>
                    <td>@p.PatientName</td>
                    <td>@p.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                    <td>@p.Gender</td>
                    <td>@p.Address</td>
                    <td>
                        <span class="badge @(p.IsDeleted ? "bg-danger" : "bg-success")">
                            @(p.IsDeleted ? "Deleted" : "Active")
                        </span>
                    </td>
                    <td>
                        <a asp-controller="AdminPatient" asp-action="Edit" asp-route-id="@p.PatientId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-controller="AdminPatient" asp-action="Details" asp-route-id="@p.PatientId" class="btn btn-info btn-sm text-white">Details</a>
                        <button type="button" class="btn btn-danger btn-sm btn-delete" data-id="@p.PatientId" data-name="@p.PatientName">
                            Delete
                        </button>
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center">No patients found</td></tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(
        Model,
        page => Url.Action("Index", new { page, search = ViewBag.Search, gender = ViewBag.Gender }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 10,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>

<!-- Modal Delete -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete patient <strong id="patientName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnDeleteConfirm">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let deleteId = 0;
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                deleteId = btn.dataset.id;
                document.getElementById('patientName').textContent = btn.dataset.name;
                modal.show();
            });
        });

        document.getElementById('btnDeleteConfirm').addEventListener('click', async () => {
            const response = await fetch(`/AdminPatient/DeleteConfirmed/${deleteId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });

            if (response.ok) {
                modal.hide();
                document.querySelector(`#row-${deleteId}`)?.remove();
            } else {
                alert('Delete failed');
            }
        });
    </script>
}

<style>
    table th { text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; }
    tbody tr:hover { background-color: #f8f9fa; transition: 0.2s; }
    .badge.bg-danger { background-color: #dc3545 !important; color: white; }
    .badge.bg-success { background-color: #198754 !important; color: white; }
    .btn-info.text-white { color: white; }
</style>
