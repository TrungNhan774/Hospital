@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<DAL.Models.DTO.PatientDTO>

@{
    ViewBag.Title = "Patients Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    bool showDeleted = ViewBag.ShowDeleted ?? false;

    string currentSearch = ViewBag.Search;
    string currentGender = ViewBag.Gender;
    int currentPage = Model.PageNumber;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-people-fill me-2"></i> @ViewBag.Title
        </h2>

        <div class="d-flex gap-2">
            <a asp-controller="AdminPatient"
               asp-action="ToggleDeleted"
               asp-route-showDeleted="@(showDeleted ? "false" : "true")"
               asp-route-search="@currentSearch"
               asp-route-gender="@currentGender"
               asp-route-page="@currentPage"
               class="btn btn-outline-secondary shadow-sm">
                <i class="bi @(showDeleted ? "bi-eye-slash" : "bi-eye") me-1"></i>
                @(showDeleted ? "Hide Deleted" : "Show Deleted")
            </a>

            <a asp-controller="AdminPatient"
               asp-action="Create"
               class="btn btn-success shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add New Patient
            </a>
        </div>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or address..." />
        </div>
        <div class="col-md-3">
            <select name="gender" class="form-select">
                <option value="">All Genders</option>
                <option value="Male" selected="@(ViewBag.Gender?.ToString() == "Male")">Male</option>
                <option value="Female" selected="@(ViewBag.Gender?.ToString() == "Female")">Female</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="hidden" name="showDeleted" value="@showDeleted" />
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i> Search
            </button>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="bi bi-info-circle me-2"></i>No patients found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary">
                            <tr class="text-center">
                                <th>Patient Name</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th style="width: 280px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr class="text-center @(p.IsDeleted ? "table-danger" : "")">
                                    <td class="fw-semibold text-start ps-4">
                                        @p.PatientName
                                        @if (!string.IsNullOrEmpty(p.UserFullName))
                                        {
                                            <small class="text-muted d-block">(User: @p.UserFullName)</small>
                                        }
                                    </td>
                                    <td>@p.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="badge bg-@(p.Gender == "Male" ? "primary" : "pink") bg-opacity-75 px-3 py-2">
                                            @p.Gender
                                        </span>
                                    </td>
                                    <td class="text-start">@p.Address</td>
                                    <td>
                                        @if (p.IsDeleted)
                                        {
                                            <span class="badge bg-danger bg-opacity-75 px-3 py-2">Deleted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-75 px-3 py-2">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <a asp-controller="AdminPatient"
                                               asp-action="Details"
                                               asp-route-id="@p.PatientId"
                                               class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                <i class="bi bi-eye me-1"></i> Details
                                            </a>

                                            <a asp-controller="AdminPatient"
                                               asp-action="Edit"
                                               asp-route-id="@p.PatientId"
                                               class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>

                                            @if (!p.IsDeleted)
                                            {
                                                <form asp-controller="AdminPatient"
                                                      asp-action="Delete"
                                                      asp-route-id="@p.PatientId"
                                                      asp-route-showDeleted="@showDeleted"
                                                      asp-route-search="@currentSearch"
                                                      asp-route-gender="@currentGender"
                                                      asp-route-page="@currentPage"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('🚨 Confirm Soft Delete:\nAre you sure you want to soft-delete patient **@p.PatientName**?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="AdminPatient"
                                                      asp-action="Restore"
                                                      asp-route-id="@p.PatientId"
                                                      asp-route-showDeleted="@showDeleted"
                                                      asp-route-search="@currentSearch"
                                                      asp-route-gender="@currentGender"
                                                      asp-route-page="@currentPage"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('♻️ Confirm Restore:\nAre you sure you want to restore patient **@p.PatientName**?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.Search, gender = ViewBag.Gender, showDeleted = ViewBag.ShowDeleted }),
            new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                DisplayLinkToIndividualPages = true,
                MaximumPageNumbersToDisplay = 5,
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
    </div>
        }
</div>

<style>
    table th {
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .badge.bg-pink {
        background-color: #e83e8c !important;
        color: white;
    }

    .btn-outline-info:hover {
        background-color: #0dcaf0;
        color: white;
    }

    .btn-outline-warning:hover {
        background-color: #ffc107;
        color: white;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    .btn-outline-success:hover {
        background-color: #198754;
        color: white;
    }

    tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease-in-out;
    }
</style>