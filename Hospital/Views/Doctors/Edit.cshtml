@model DAL.Models.Doctor

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Doctor";
}

<h2 class="mb-3">Edit Doctor</h2>

<form asp-action="Edit" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    
    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden" asp-for="CreatedAt" />
    <input type="hidden" asp-for="UpdatedAt" />

    <div class="mb-3">
        <label asp-for="UserId" class="form-label"></label>
        <select asp-for="UserId" class="form-select @(ViewData.ModelState["UserId"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-items="ViewBag.UserId">
            <option value="">-- Select User --</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" class="form-select @(ViewData.ModelState["DepartmentId"]?.Errors.Count > 0 ? "is-invalid" : "")" asp-items="ViewBag.DepartmentId">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select @(ViewData.ModelState["Gender"]?.Errors.Count > 0 ? "is-invalid" : "")">
                <option value="">-- Select Gender --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control @(ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control @(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control @(ViewData.ModelState["Address"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Qualification" class="form-label"></label>
        <input asp-for="Qualification" class="form-control @(ViewData.ModelState["Qualification"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Qualification" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Specialization" class="form-label"></label>
        <input asp-for="Specialization" class="form-control @(ViewData.ModelState["Specialization"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Specialization" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExperienceYears" class="form-label"></label>
        <input asp-for="ExperienceYears" class="form-control @(ViewData.ModelState["ExperienceYears"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="ExperienceYears" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="About" class="form-label"></label>
        <textarea asp-for="About" class="form-control @(ViewData.ModelState["About"]?.Errors.Count > 0 ? "is-invalid" : "")" rows="3"></textarea>
        <span asp-validation-for="About" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Photo" class="form-label"></label>
        <input asp-for="Photo" class="form-control @(ViewData.ModelState["Photo"]?.Errors.Count > 0 ? "is-invalid" : "")" />
        <span asp-validation-for="Photo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
