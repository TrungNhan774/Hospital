@model DAL.Models.Doctor

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Doctor Details";
}

<h1 class="mb-3">Doctor Details</h1>

<div class="card shadow-sm p-4 mb-4 bg-white rounded">
    <h4 class="mb-3">Doctor Information</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FullName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Gender)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Gender)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DateOfBirth)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Qualification)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Qualification)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Specialization)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Specialization)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ExperienceYears)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ExperienceYears)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.About)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.About)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Photo)</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="@Url.Content(Model.Photo)" alt="Doctor Photo" class="img-thumbnail" style="max-height:150px;" />
            }
            else
            {
                <span>No Photo</span>
            }
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UpdatedAt)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Department.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Department.Name)</dd>

        <dt class="col-sm-3">User Account</dt>
        <dd class="col-sm-9">
            @if(Model.User != null)
            {
                <div>Username: @Model.User.Username</div>
                <div>Email: @Model.User.Email</div>
                <div>Role: @Model.User.Role</div>
            }
            else
            {
                <span>No User Assigned</span>
            }
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-primary me-2">Edit Doctor</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
