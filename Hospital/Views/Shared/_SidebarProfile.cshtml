<div class="col-md-3 col-lg-2 bg-white shadow-sm sidebar p-4">
    <h4 class="fw-bold text-primary mb-4">Customer Account</h4>

    <ul class="list-unstyled">
        <li class="mb-3">
            <a asp-action="Index" asp-controller="Profile" class="text-decoration-none fw-semibold">
                <i class="bi bi-person-circle me-2"></i> Customer Profile
            </a>
        </li>
        
        <li class="mb-3">
            <a asp-action="ChangePassword" asp-controller="Profile" class="text-decoration-none fw-semibold">
                <i class="bi bi-shield-lock me-2"></i>Change Password
            </a>
        </li>
        <li class="mt-4 pt-3 border-top">
            <a asp-action="Logout" asp-controller="Account" class="text-danger fw-semibold text-decoration-none">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </li>
    </ul>
</div>