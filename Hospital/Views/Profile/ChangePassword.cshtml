@model DAL.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="profile-wrapper container-fluid">
    <div class="row">

        <!-- Import Customer Sidebar -->
        <partial name="~/Views/Shared/_SidebarProfile.cshtml" />

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 d-flex justify-content-center align-items-center profile-content">
            <div class="profile-card shadow p-5 rounded-4 bg-white w-100" style="max-width: 650px;">
                <h2 class="fw-bold mb-4 text-primary text-center">Change Password</h2>

                <form method="post">
                    <input type="hidden" asp-for="UserId" />
                    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage?.ToString()))
                    {
                        <p class="text-success mt-3 fw-semibold">@ViewBag.SuccessMessage</p>
                    }
                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold">Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" />
                        <span class="text-danger" asp-validation-for="CurrentPassword"></span>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" />
                        <span class="text-danger" asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 me-2">
                            <i class="bi bi-check2"></i> Save
                        </button>
                        <a asp-action="Index" asp-controller="Profile" class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        .profile-wrapper {
            min-height: 100vh;
            background: #f1f7ff;
        }

        .sidebar {
            min-height: 100vh;
            border-right: 1px solid rgba(0,0,0,0.1);
        }

            .sidebar a {
                color: #333;
                transition: color .2s;
            }

                .sidebar a:hover,
                .active-link {
                    color: #007bff !important;
                }

        .profile-content {
            padding: 40px;
        }

        .profile-card {
            border: 1px solid rgba(0,0,0,0.05);
        }
    </style>
}