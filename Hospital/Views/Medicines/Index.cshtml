@using X.PagedList
@using X.PagedList.Mvc.Core
@model IEnumerable<DAL.Models.Medicine>
@{
    ViewBag.Title = "Medicines";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Medicines</h2>
    <a href="/Medicines/Create" class="btn btn-primary">Add Medicine</a>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<!-- Search form -->
<form method="get" asp-action="Index" class="mb-3 d-flex">
    <input type="text"
           name="searchString"
           class="form-control me-2"
           placeholder="Search by name..."
           value="@ViewBag.SearchString" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (!string.IsNullOrEmpty(ViewBag.SearchString))
    {
        <a href="/Medicines" class="btn btn-outline-secondary ms-2">Clear</a>
    }
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Unit</th>
            <th>Description</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row-@item.MedicineId">
                <td>@item.MedicineId</td>
                <td>@item.Name</td>
                <td>@item.Unit</td>
                <td>@item.Description</td>
                <td>@item.Price.ToString("N2")</td>
                <td>@(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                <td>
                    <a href="/Medicines/Edit/@item.MedicineId" class="btn btn-warning btn-sm">Edit</a>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            onclick="confirmDelete(@item.MedicineId, '@(item.Name.Replace("'", "\\'"))')">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
<div class="d-flex justify-content-center mt-3">
    @Html.PagedListPager(
    (IPagedList)Model,
        page => Url.Action("Index", new { page, searchString = ViewBag.SearchString }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 10,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>


<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="medicineName"></strong> ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnDeleteConfirm">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let deleteId = 0;

        // Hàm mở modal xác nhận xóa
        function confirmDelete(id, name) {
            deleteId = id;
            document.getElementById("medicineName").textContent = name;

            const modal = new bootstrap.Modal(document.getElementById("deleteModal"));
            modal.show();
        }

        // Khi nhấn nút "Xóa" trong modal
        document.getElementById("btnDeleteConfirm").addEventListener("click", function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch(`/Medicines/DeleteConfirmed/${deleteId}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                }
            })
            .then(response => {
                if (response.ok) {
                    // Ẩn modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById("deleteModal"));
                    modal.hide();

                    // Xóa hàng trong bảng
                    document.getElementById(`row-${deleteId}`)?.remove();
                } else {
                    alert("Xóa thất bại!");
                }
            })
            .catch(() => alert("Lỗi kết nối đến server!"));
        });
    </script>
}
