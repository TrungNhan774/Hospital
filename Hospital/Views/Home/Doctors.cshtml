@model IEnumerable<DAL.Models.Doctor>
@{
    ViewData["Title"] = "List of Doctors and Specialists";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/doctors.css" />

<!-- ===== Main Banner ===== -->
<section class="doctor-banner position-relative text-white text-center">
    <div class="banner-overlay"></div>
    <div class="banner-content position-relative py-5">
        <h1 class="fw-bold display-5">LIST OF DOCTORS & SPECIALISTS</h1>
        <div class="underline mx-auto mt-3"></div>
    </div>
</section>

<!-- ===== Filter Panel ===== -->
<section class="filter-panel py-4 bg-light border-bottom">
    <div class="container">
        <div class="row justify-content-center g-3">
            <div class="col-md-4 col-sm-10">
                <select id="departmentSelect" class="form-select rounded-pill shadow-sm">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.DepartmentId">@dept.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 col-sm-10">
                <input type="text" id="searchInput" class="form-control rounded-pill shadow-sm"
                       placeholder="Search by name, department, or qualification..." />
            </div>
        </div>
    </div>
</section>

<!-- ===== Doctors List ===== -->
<section class="container py-5">
    <div id="doctorList">
        @await Html.PartialAsync("_DoctorsListPartial", Model)
    </div>
</section>

<!-- ===== AJAX Script ===== -->
<script>
    const searchInput = document.getElementById("searchInput");
    const departmentSelect = document.getElementById("departmentSelect");

    async function filterDoctors() {
        const search = searchInput.value;
        const dept = departmentSelect.value;

        const url = `/Home/FilterDoctors?searchString=${encodeURIComponent(search)}&departmentId=${dept}`;
        const response = await fetch(url);
        const html = await response.text();
        document.getElementById("doctorList").innerHTML = html;
    }

    // Filter automatically when typing or selecting a department
    searchInput.addEventListener("input", () => {
        clearTimeout(window._searchTimer);
        window._searchTimer = setTimeout(filterDoctors, 400); // debounce 0.4s
    });
    departmentSelect.addEventListener("change", filterDoctors);
</script>
