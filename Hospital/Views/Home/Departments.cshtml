@model IEnumerable<DAL.Models.Department>
@{
    ViewData["Title"] = "Department List";
}

<!-- ============================= -->
<!-- 🎯 TOP BANNER -->
<!-- ============================= -->

<!-- ===== Main Banner ===== -->
<section class="service-banner position-relative text-white text-center"
         style="background: url('/images/doctor_banner.jpg') center/cover no-repeat;">
    <div class="banner-overlay"></div>
    <div class="banner-content position-relative py-5">
        <h1 class="fw-bold display-5">Department List</h1>
        <div class="underline mx-auto mt-3"></div>
        <p class="fw-bold">
            Explore top departments and our team of dedicated specialists
        </p>
    </div>
</section>


<!-- ============================= -->
<!-- 🎯 DEPARTMENT LIST -->
<!-- ============================= -->
<div class="container py-5">
    <div class="row g-4">
        @foreach (var dep in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card department-card shadow-sm border-0 rounded-4 h-100 text-center p-4">
                    <div class="card-body d-flex flex-column justify-content-between">

                        <div>
                            <h5 class="fw-bold text-primary mb-2">@dep.Name</h5>
                            <p class="text-muted">
                                @(string.IsNullOrEmpty(dep.Description)
                                                            ? "No description available for this department."
                                                            : dep.Description.Length > 90
                                                            ? dep.Description.Substring(0, 90) + "..."
                                                            : dep.Description)
                        </p>
                    </div>

                        <div>
                            <a asp-action="DepartmentDetails" asp-route-id="@dep.DepartmentId"
                               class="btn btn-outline-success rounded-pill px-4 mt-3">
                                View details
                            </a>
                        </div>

                    </div>
                </div>
            </div>
                }
    </div>
</div>
