@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Banner -->
<section class="hero position-relative text-center text-white">
    <div class="hero-overlay d-flex flex-column justify-content-center align-items-center">
    </div>
</section>

<!-- Các tiện ích nhanh -->
<section class="quick-actions py-5 bg-light">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <i class="bi bi-telephone-fill text-primary fs-1 mb-3"></i>
                    <h5 class="fw-bold mb-2">Call the operator</h5>
                    <p class="text-muted">Support consulting and answering questions 24/7.</p>
                    <a href="tel:19001001" class="btn btn-outline-primary rounded-pill px-4">1900 1001</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <i class="bi bi-calendar-check-fill text-success fs-1 mb-3"></i>
                    <h5 class="fw-bold mb-2">Make Appointment</h5>
                    <p class="text-muted">Choose the right time and doctor in just a few steps.</p>
                    <a href="@Url.Action("Index", "PatientAppointment")" class="btn btn-success rounded-pill px-4">Book</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <i class="bi bi-person-vcard-fill text-info fs-1 mb-3"></i>
                    <h5 class="fw-bold mb-2">Find a doctor</h5>
                    <p class="text-muted">Look up information about FUMini's medical team.</p>
                    <a href="@Url.Action("Doctors", "Home")" class="btn btn-info text-white rounded-pill px-4">See now</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Giới thiệu -->
<section class="intro py-5">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-md-6">
                <img src="@Url.Content("~/images/infoHospital.jpg")" class="img-fluid rounded-4 shadow" alt="Hospital introduction" />
            </div>
            <div class="col-md-6">
                <h2 class="fw-bold mb-3">About us</h2>
                <p>FUMini Hospital is a modern medical facility, providing comprehensive medical examination and treatment services with a team of experienced doctors and international standard facilities.</p>
            </div>
        </div>
    </div>
</section>


<!-- Dịch vụ nổi bật -->
<section class="services py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">Outstanding services</h2>
        <div class="row g-4">

            <div class="col-md-4">
                <a href="@Url.Action("OverviewService", "Home")" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm service-card-link">
                        <img src="@Url.Content("~/images/GeneralExamination.jpg")" class="card-img-top" alt="General examination" />
                        <div class="card-body">
                            <h5 class="card-title fw-bold">General examination</h5>
                            <p class="card-text text-muted">Regular health check-ups help detect underlying diseases early.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("OverviewService", "Home")" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm service-card-link">
                        <img src="@Url.Content("~/images/SpecialistExamination.jpg")" class="card-img-top" alt="Specialist examination" />
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Specialist examination</h5>
                            <p class="card-text text-muted">Specialized medical examination and treatment services for each medical field.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="@Url.Action("OverviewService", "Home")" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm service-card-link">
                        <img src="@Url.Content("~/images/Testing&Diagnosis.jpg")" class="card-img-top" alt="Testing and Diagnosis" />
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Testing and Diagnosis</h5>
                            <p class="card-text text-muted">Applying advanced and precise testing and imaging technology.</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>


<!-- 🏥 Department Specialties -->
<section class="departments py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">Department Specialties</h2>
        <div class="row g-4">

            <!-- Cardiovascular -->
            <div class="col-md-3 col-6">
                <a href="@Url.Action("Departments", "Home")" class="text-decoration-none text-dark">
                    <div class="dept-card border rounded-4 shadow-sm h-100 overflow-hidden">
                        <img src="@Url.Content("~/images/tim.png")" alt="Cardiovascular" class="img-fluid">
                        <div class="p-3">
                            <h6 class="fw-bold mt-3">Cardiovascular</h6>
                            <p>Advanced heart care and cardiac surgery.</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Eye -->
            <div class="col-md-3 col-6">
                <a href="@Url.Action("Departments", "Home")" class="text-decoration-none text-dark">
                    <div class="dept-card border rounded-4 shadow-sm h-100 overflow-hidden">
                        <img src="@Url.Content("~/images/eye.jpg")" alt="Eye Department" class="img-fluid">
                        <div class="p-3">
                            <h6 class="fw-bold mt-3">Eye</h6>
                            <p>Comprehensive vision and eye health services.</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Surgery -->
            <div class="col-md-3 col-6">
                <a href="@Url.Action("Departments", "Home")" class="text-decoration-none text-dark">
                    <div class="dept-card border rounded-4 shadow-sm h-100 overflow-hidden">
                        <img src="@Url.Content("~/images/ngoaikhoa.jpg")" alt="Surgery Department" class="img-fluid">
                        <div class="p-3">
                            <h6 class="fw-bold mt-3">Surgery</h6>
                            <p>Safe and modern surgical treatments.</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Respiration -->
            <div class="col-md-3 col-6">
                <a href="@Url.Action("Departments", "Home")" class="text-decoration-none text-dark">
                    <div class="dept-card border rounded-4 shadow-sm h-100 overflow-hidden">
                        <img src="@Url.Content("~/images/hohap.jpg")" alt="Respiration Department" class="img-fluid">
                        <div class="p-3">
                            <h6 class="fw-bold mt-3">Respiration</h6>
                            <p>Specialized lung and respiratory care.</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>



<!-- Liên hệ -->
<section id="contact-section" class="contact py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Contact us</h2>
        <p>Hotline: <b>1900 1001</b> | Email: <b>info@fuminihospital.com</b></p>
        <a href="@Url.Action("Index", "Home")#contact-section" class="btn btn-primary mt-3 rounded-pill px-4">Submit request</a>
    </div>
</section>

<!-- CSS -->
<style>
    /* HERO */
    .hero {
        background: url('@Url.Content("~/images/banner_homepage.png")') center/cover no-repeat;
        height: 70vh;
        position: relative;
    }

    .hero-overlay {
        background: rgba(255, 255, 255, 0); /* bỏ lớp phủ tối */
        width: 100%;
        height: 100%;
        color: #004080; /* đổi text sang màu xanh đậm cho dễ đọc trên nền sáng */
        text-shadow: 1px 1px 2px rgba(255,255,255,0.7); /* tạo hiệu ứng sáng nhẹ */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    /* QUICK ACTIONS */
    .quick-actions .card {
        transition: all 0.3s ease;
    }

        .quick-actions .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

    /* DEPARTMENTS */
    .dept-card {
        transition: 0.3s ease;
    }

        .dept-card:hover {
            background-color: #f8f9fa;
            transform: translateY(-5px);
        }
</style>
